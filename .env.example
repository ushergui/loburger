# Copie para .env e ajuste. O .env NÃO é versionado.
# Em Windows, defina como variáveis de ambiente ou use o iniciar_servidor_producao.bat.

# Gere uma chave nova (>= 50 caracteres aleatórios):
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
LOLBURGUER_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# False = modo produção (sem páginas de erro detalhadas)
LOLBURGUER_DEBUG=False

# Hosts/IPs pelos quais o sistema é acessado, separados por vírgula
LOLBURGUER_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.10

# Se acessar por http://192.168.0.10:8080 etc, liste as origens para o CSRF
LOLBURGUER_CSRF_TRUSTED_ORIGINS=http://192.168.0.10:8080

# Só ligue se o sistema for servido atrás de HTTPS/TLS
LOLBURGUER_HTTPS=False
